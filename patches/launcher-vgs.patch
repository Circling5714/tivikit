@@ -0,0 +1,90 @@
+package com.gathin.tvhome;
+
+import android.content.ComponentName;
+import android.content.Context;
+import android.content.pm.ApplicationInfo;
+import android.content.pm.PackageManager;
+import android.media.MediaMetadata;
+import android.media.session.MediaController;
+import android.media.session.MediaSessionManager;
+import android.media.session.PlaybackState;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * CleanTV/VGS: the apps playing media right now (feedback 24/10/2026: "nhiều khi phát chồng hai ba ứng dụng không
+ * tắt được"). Needs NowPlayingListener to be an allowed notification listener; otherwise every call returns nothing.
+ */
+final class NowPlaying {
+    private NowPlaying() {
+    }
+
+    static ComponentName listener(Context ctx) {
+        return new ComponentName(ctx, NowPlayingListener.class);
+    }
+
+    /** Sessions that are playing, buffering or paused (a paused one can still be resumed or stopped). */
+    static List<MediaController> active(Context ctx) {
+        List<MediaController> ds = new ArrayList<>();
+        MediaSessionManager m = ctx.getSystemService(MediaSessionManager.class);
+        if (m == null) return ds;
+        try {
+            for (MediaController c : m.getActiveSessions(listener(ctx))) {
+                if (c.getPackageName().equals(ctx.getPackageName())) continue;
+                int s = state(c);
+                if (s == PlaybackState.STATE_PLAYING || s == PlaybackState.STATE_BUFFERING || s == PlaybackState.STATE_PAUSED) ds.add(c);
+            }
+        } catch (SecurityException notAllowed) {
+            // The listener is not allowed: no button.
+        }
+        return ds;
+    }
+
+    static boolean anyPlaying(List<MediaController> ds) {
+        for (MediaController c : ds) {
+            int s = state(c);
+            if (s == PlaybackState.STATE_PLAYING || s == PlaybackState.STATE_BUFFERING) return true;
+        }
+        return false;
+    }
+
+    static int state(MediaController c) {
+        PlaybackState p = c.getPlaybackState();
+        return p == null ? PlaybackState.STATE_NONE : p.getState();
+    }
+
+    static boolean playing(MediaController c) {
+        int s = state(c);
+        return s == PlaybackState.STATE_PLAYING || s == PlaybackState.STATE_BUFFERING;
+    }
+
+    /** "App · title", the title when the session publishes one. */
+    static String label(Context ctx, MediaController c) {
+        String app = c.getPackageName();
+        try {
+            PackageManager pm = ctx.getPackageManager();
+            ApplicationInfo ai = pm.getApplicationInfo(app, 0);
+            app = pm.getApplicationLabel(ai).toString();
+        } catch (PackageManager.NameNotFoundException ignored) {
+        }
+        MediaMetadata md = c.getMetadata();
+        CharSequence title = md == null ? null : md.getText(MediaMetadata.METADATA_KEY_TITLE);
+        return title == null || title.length() == 0 ? app : app + " · " + title;
+    }
+
+    static void toggle(MediaController c) {
+        if (playing(c)) c.getTransportControls().pause();
+        else c.getTransportControls().play();
+    }
+
+    static void stopAll(List<MediaController> ds) {
+        for (MediaController c : ds) {
+            try {
+                c.getTransportControls().pause();
+                c.getTransportControls().stop();
+            } catch (RuntimeException ignored) {
+            }
+        }
+    }
+}
