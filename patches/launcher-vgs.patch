+        if (m != null) m.removeOnActiveSessionsChangedListener(nghePhien);
+        nghePhien = null;
+    }
+
+    private void capNhatDangPhat() {
+        if (btnNowPlaying == null) return;
+        boolean co = !NowPlaying.active(this).isEmpty();
+        int vis = co ? View.VISIBLE : View.GONE;
+        if (btnNowPlaying.getVisibility() != vis) btnNowPlaying.setVisibility(vis);
+    }
+
+    /** CleanTV/VGS: a list of what plays; OK on a row pauses / resumes it, Stop all pauses and stops every one. */
+    private void showNowPlaying() {
+        java.util.List<android.media.session.MediaController> ds = NowPlaying.active(this);
+        if (ds.isEmpty()) {
+            Toast.makeText(this, R.string.now_playing_none, Toast.LENGTH_SHORT).show();
+            capNhatDangPhat();
+            return;
+        }
+        String[] dong = new String[ds.size()];
+        for (int i = 0; i < ds.size(); i++) {
+            android.media.session.MediaController c = ds.get(i);
+            dong[i] = (NowPlaying.playing(c) ? "⏸ " + getString(R.string.now_playing_pause) : "▶ " + getString(R.string.now_playing_play))
+                    + "  ·  " + NowPlaying.label(this, c);
+        }
+        new android.app.AlertDialog.Builder(this)
+                .setTitle(R.string.now_playing)
+                .setItems(dong, (d, i) -> {
+                    NowPlaying.toggle(ds.get(i));
+                    root.postDelayed(this::capNhatDangPhat, 600);
+                })
+                .setPositiveButton(R.string.now_playing_stop_all, (d, w) -> {
+                    NowPlaying.stopAll(ds);
+                    root.postDelayed(this::capNhatDangPhat, 600);
+                })
+                .show();
+    }
+
+    /** CleanTV/VGS: one rounded cluster of round icon buttons; the labels move to contentDescription. */
+    private void gomNut() {
+        LinearLayout top = findViewById(R.id.topButtons);
+        top.setBackgroundResource(R.drawable.cum_bg);
+        int p = Math.round(4 * density);
+        top.setPadding(p, p, p, p);
+        for (int i = 0; i < top.getChildCount(); i++) {
+            if (!(top.getChildAt(i) instanceof TextView)) continue;
+            TextView b = (TextView) top.getChildAt(i);
+            CharSequence chu = b.getText();
+            if (chu != null && chu.length() > 0) b.setContentDescription(chu);
+            b.setText("");
+            b.setCompoundDrawablePadding(0);
+            b.setBackgroundResource(R.drawable.cum_nut_bg);
+            int s = Math.round(42 * density), pad = Math.round(10 * density);
+            b.setPadding(pad, 0, pad, 0);
+            b.setMaxWidth(s);
+            LinearLayout.LayoutParams lp = (LinearLayout.LayoutParams) b.getLayoutParams();
+            lp.width = s;
+            lp.setMarginStart(Math.round(2 * density));
+            b.setLayoutParams(lp);
+        }
+    }
+
+    /**
+     * CleanTV/VGS: start the screensaver now. A normal app may not call the dream service, so ask the TV's own
+     * "start screensaver" voice action first (Android TV settings), then SystemUI's Somnambulator, then Settings.
+     */
+    private void startScreensaver() {
+        Intent[] thu = {
+                new Intent("com.google.android.pano.action.SLEEP"),
+                new Intent().setComponent(new android.content.ComponentName("com.android.systemui", "com.android.systemui.Somnambulator")),
+        };
+        for (Intent i : thu) {
+            i.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK);
+            try {
+                startActivity(i);
+                return;
+            } catch (Exception ignored) {
+                // Not on this TV: try the next way.
+            }
+        }
+        open(new Intent(Settings.ACTION_SETTINGS));
+    }
+
+    /** CleanTV/VGS: start one of the maker's projector screens (package/activity). */
+    private void openComponent(String comp) {
+        android.content.ComponentName cn = android.content.ComponentName.unflattenFromString(comp);
+        if (cn == null) return;
+        open(new Intent().setComponent(cn));
+    }
+
+    private void showProjectorMenu(java.util.List<String[]> items) {
+        View anchor = findViewById(R.id.btnProjector);
+        View panel = getLayoutInflater().inflate(R.layout.popup_inputs, root, false);
+        LinearLayout rows = panel.findViewById(R.id.rows);
+        PopupWindow popup = glassPopup(panel, (int) (200 * density));
+        for (String[] it : items) addSettingsMenuRow(rows, popup, it[0], () -> openComponent(it[1]));
+        panel.measure(View.MeasureSpec.UNSPECIFIED, View.MeasureSpec.UNSPECIFIED);
+        popup.setWidth(Math.max((int) (200 * density), panel.getMeasuredWidth()));
+        dropIn(popup, panel, anchor, Gravity.START);
         rows.getChildAt(0).requestFocus();
     }
 
     private void addSettingsMenuRow(LinearLayout rows, PopupWindow popup, int title, Runnable action) {
+        addSettingsMenuRow(rows, popup, getString(title), action);
+    }
+
+    private void addSettingsMenuRow(LinearLayout rows, PopupWindow popup, CharSequence title, Runnable action) {
         View row = getLayoutInflater().inflate(R.layout.item_input, rows, false);
         row.findViewById(R.id.icon).setVisibility(View.GONE);
         row.findViewById(R.id.dot).setVisibility(View.GONE);
