diff --git a/launcher/app/src/main/res/font/outfit_extralight.xml b/launcher/app/src/main/res/font/outfit_extralight.xml
index 397e2989..f12687b6 100644
--- a/launcher/app/src/main/res/font/outfit_extralight.xml
+++ b/launcher/app/src/main/res/font/outfit_extralight.xml
@@ -1,13 +1,12 @@
 <?xml version="1.0" encoding="utf-8"?>
-<!-- Outfit at weight 200, built once per process. android:fontVariationSettings on each TextView rebuilt
+<!-- CleanTV/VGS: Lexend TĨNH từng độ đậm (bản biến thiên vỡ dấu tiếng Việt trên Android 9 — Sony KD-49X8000G, 22/10/2026). Lexend thay Outfit (Outfit thiếu 96 chữ tiếng Việt, ặ/ộ/ư… rơi về font hệ thống). Was: Outfit at weight 200, built once per process. android:fontVariationSettings on each TextView rebuilt
      the variable font for every view (about 10 ms each on a TV CPU). Android 8 ignores the weight here, as
      it did on the views, and draws the default instance. -->
 <font-family xmlns:android="http://schemas.android.com/apk/res/android"
     xmlns:tools="http://schemas.android.com/tools">
     <font
-        android:font="@font/outfit"
+        android:font="@font/lexend_extralight"
         android:fontStyle="normal"
         android:fontWeight="200"
-        android:fontVariationSettings="'wght' 200"
         tools:targetApi="28" />
 </font-family>
