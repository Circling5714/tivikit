<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Không có màn mở trong danh sách app, không hiện bàn phím: TiviKit bật bộ gõ này vài giây mỗi lần gửi chữ có dấu. -->
    <application
        android:label="@string/ten_app"
        android:icon="@drawable/ic_go"
        android:allowBackup="false"
        android:supportsRtl="true">
        <service
            android:name=".BoGo"
            android:exported="true"
            android:label="@string/ten_app"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data android:name="android.view.im" android:resource="@xml/bo_go" />
        </service>
        <!-- Chữ chỉ gửi được từ ADB (TiviKit). -->
        <provider
            android:name=".ChuProvider"
            android:authorities="${applicationId}"
            android:exported="true" />
    </application>
</manifest>
