<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Thời tiết từ Open-Meteo cho nơi TiviKit gửi. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Tên Wi-Fi trên nút mạng: Android chỉ cho app có quyền vị trí đọc. Không hỏi người dùng; TiviKit cấp qua ADB. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Nút "Dọn RAM": đóng tiến trình nền của các app (Android 14+ không cho đóng app khác, nút ẩn đi). -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <!-- Mục "Gỡ cài đặt" trong menu app: mở hộp gỡ của hệ thống. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- App mở gần đây cả khi mở bằng giọng nói / nút remote: TiviKit cấp qua ADB (appops GET_USAGE_STATS). -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <!-- Android 11+: thấy các app có màn mở (app tivi và app điện thoại cài thêm). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Biết gói nào là launcher để không đưa vào phần app gần đây. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <!-- Mục "Khoá trẻ em ngay" của menu ⏻ chỉ hiện khi tivi có app Khoá trẻ em của TiviKit. -->
        <package android:name="vn.tivikit.khoa" />
        <!-- Tivi MediaTek: menu nguồn của Android khởi động lại thành tắt hẳn, nên Khởi động lại dẫn vào Cài đặt khi không có ADB. -->
        <package android:name="com.mediatek.tv.service" />
    </queries>

    <!-- Không có ô trong danh sách app: cài, chọn làm Home và chỉnh ở TiviKit trên điện thoại. -->
    <application
        android:label="TiviKit Launcher"
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/banner"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:theme="@style/NenToi">
        <!-- exported: TiviKit mở thử bằng am start, Home sạch mở đè lên Home gốc (home_target) trên Google TV. -->
        <activity
            android:name=".ManHome"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true"
            android:excludeFromRecents="true"
            android:resumeWhilePausing="true"
            android:taskAffinity=""
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|density|uiMode|locale|layoutDirection|fontScale" />
        <!-- Nút Home: tắt sẵn để cài / cập nhật không làm tivi hỏi chọn Home; khi người dùng chọn TiviKit Launcher làm
             Home ở màn Quản lý launcher, TiviKit nhờ app tự bật (content call … bat-home, xem CauHinhProvider). -->
        <activity-alias
            android:name=".Home"
            android:targetActivity=".ManHome"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>
        <!-- Thẻ Đang phát: quyền đọc phiên phát nhạc / video (không đọc thông báo); TiviKit cho phép qua
             cmd notification allow_listener. -->
        <service
            android:name=".NgheNhac"
            android:exported="true"
            android:label="TiviKit Launcher"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <!-- Menu ⏻: tắt tivi, mở menu nguồn (NguonDichVu). TiviKit bật nó trong danh sách trợ năng khi cài launcher. -->
        <service
            android:name=".NguonDichVu"
            android:exported="true"
            android:label="@string/ten_nguon"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/nguon_tro_nang" />
        </service>
        <!-- Cấu hình (tên lời chào, dock, ngôn ngữ, nơi xem thời tiết, câu kinh) chỉ đặt được từ ADB (TiviKit). -->
        <provider
            android:name=".CauHinhProvider"
            android:authorities="${applicationId}"
            android:exported="true" />
    </application>
</manifest>
