<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Tên Wi-Fi trên nút mạng: Android chỉ cho app có quyền vị trí đọc. Không hỏi người dùng; TiviKit cấp qua ADB. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Nút "Dọn RAM": đóng tiến trình nền của các app (Android 14+ không cho đóng app khác, nút ẩn đi). -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <!-- Mục "Gỡ cài đặt" trong menu app: mở hộp gỡ của hệ thống. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <!-- Android 11+: thấy các app có màn mở (app tivi và app điện thoại cài thêm). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!-- Không có ô trong danh sách app: cài, chọn làm Home và chỉnh ở TiviKit trên điện thoại. -->
    <application
        android:label="TiviKit Launcher"
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/banner"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:theme="@style/NenToi">
        <!-- exported: TiviKit mở thử bằng am start, Home sạch mở đè lên Home gốc (home_target) trên Google TV. -->
        <activity
            android:name=".ManHome"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true"
            android:excludeFromRecents="true"
            android:resumeWhilePausing="true"
            android:taskAffinity=""
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|density|uiMode|locale|layoutDirection|fontScale" />
        <!-- Nút Home: tắt sẵn để cài / cập nhật không làm tivi hỏi chọn Home; khi người dùng chọn TiviKit Launcher làm
             Home ở màn Quản lý launcher, TiviKit nhờ app tự bật (content call … bat-home, xem CauHinhProvider). -->
        <activity-alias
            android:name=".Home"
            android:targetActivity=".ManHome"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>
        <!-- Cấu hình (tên lời chào, dock, ngôn ngữ) chỉ đặt được từ ADB (TiviKit). -->
        <provider
            android:name=".CauHinhProvider"
            android:authorities="${applicationId}"
            android:exported="true" />
    </application>
</manifest>
