<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Mở video thì bật màn hình (tắt màn bảo vệ, tivi đang chờ thì bật); Android 14+ cần TURN_SCREEN_ON, TiviKit cấp qua ADB. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.TURN_SCREEN_ON" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Wi-Fi bỏ gói multicast cho đỡ tốn pin nếu không có app giữ khoá: cần để nghe điện thoại tìm tivi (SSDP). -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- App nào đang ở trước màn hình khi máy nhận vừa bật (chưa thấy lần đổi cửa sổ nào): SmartTube đang nghe nền thì video
         mới cũng về nghe nền. TiviKit cấp qua ADB (appops GET_USAGE_STATS); không cấp thì coi như SmartTube đang hiện. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <!-- Android 11+: thấy SmartTube (các bản) và app mở được link YouTube. -->
    <queries>
        <package android:name="org.smarttube.stable" />
        <package android:name="org.smarttube.beta" />
        <package android:name="com.liskovsoft.smarttubetv" />
        <package android:name="com.liskovsoft.smarttubetv.beta" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" android:host="www.youtube.com" />
        </intent>
        <!-- Launcher đang dùng: SmartTube đang nghe nền thì video mới xong lại về đúng launcher đó. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <!-- Khoá trẻ em: xin mã bố mẹ trước khi chặn / duyệt / huỷ liên kết (màn XacNhan của nó). -->
        <package android:name="vn.tivikit.khoa" />
    </queries>

    <!-- Bật / gỡ ở TiviKit trên điện thoại; trên tivi có màn mã TV và điện thoại đã cast (biểu tượng trong danh sách app). -->
    <application
        android:label="@string/ten_app"
        android:icon="@drawable/ic_cast"
        android:banner="@drawable/banner"
        android:allowBackup="false"
        android:supportsRtl="true">
        <!-- Mã TV cho khách, điện thoại đã cast (duyệt, chặn, huỷ mọi liên kết), tạm ngừng nhận, đổi tên. -->
        <activity
            android:name=".ManCast"
            android:exported="true"
            android:label="@string/ten_man"
            android:theme="@style/NenToi"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|density|uiMode|locale|layoutDirection|fontScale">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Máy lạ cast lần đầu: hỏi cho phép trên tivi (nổi trên app đang mở). -->
        <activity
            android:name=".XinPhep"
            android:exported="false"
            android:theme="@style/HopHoi"
            android:launchMode="singleTask"
            android:taskAffinity="vn.tivikit.cast.hoi"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|density|uiMode|locale|layoutDirection|fontScale" />
        <!-- Giữ máy nhận chạy suốt và để Android cho mở SmartTube khi app đang chạy nền. -->
        <service
            android:name=".CastDichVu"
            android:exported="true"
            android:label="@string/ten_app"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/cast_tro_nang" />
        </service>
        <!-- Chỉ để đọc / điều khiển phiên media của SmartTube (tua, vị trí thật); TiviKit bật qua ADB nếu tivi cho. -->
        <service
            android:name=".NgheThongBao"
            android:exported="true"
            android:label="@string/ten_app"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <!-- Trạng thái / tên chỉ đọc, đặt được từ ADB (TiviKit). -->
        <provider
            android:name=".CauHinhProvider"
            android:authorities="${applicationId}"
            android:exported="true" />
    </application>
</manifest>
